<!-- Navbar: shared by every page. The if/else highlights the current page (same as class). -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
    <a class="navbar-brand" href="/"><i class="fa-solid fa-server"></i> Homelab Inventory</a>
    <ul class="navbar-nav ms-auto">
      <li class="nav-item">
        <% if (title == "Home") { %>
          <a class="nav-link active" aria-current="page" href="/home"><i class="fa-solid fa-house"></i> Home</a>
        <% } else { %>
          <a class="nav-link" href="/home"><i class="fa-solid fa-house"></i> Home</a>
        <% } %>
      </li>
      <li class="nav-item">
        <% if (title == "Inventory") { %>
          <a class="nav-link active" aria-current="page" href="/devices"><i class="fa-solid fa-list"></i> Inventory</a>
        <% } else { %>
          <a class="nav-link" href="/devices"><i class="fa-solid fa-list"></i> Inventory</a>
        <% } %>
      </li>
    </ul>
  </div>
</nav>