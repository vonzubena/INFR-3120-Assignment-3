<%- include ../partials/header.ejs %>
<%- include ../partials/main_nav.ejs %>

<!-- Add Device page: a form like the Week 3 form, styled with Bootstrap -->
<main class="container py-4 form-page">
  <h1><%= title %></h1>

  <!-- Sends the form to router.post('/add') in routes/device.js.
       Each name="..." becomes req.body.name in the route. -->
  <form method="POST" action="/devices/add">
    <div class="mb-3">
      <label for="name" class="form-label">Device Name</label>
      <input type="text" class="form-control" id="name" name="name" placeholder="Proxmox Node 1" required>
    </div>

    <div class="mb-3">
      <label for="category" class="form-label">Category</label>
      <select class="form-select" id="category" name="category">
        <option value="Server">Server</option>
        <option value="Networking">Networking</option>
        <option value="Storage">Storage</option>
        <option value="Single-Board Computer">Single-Board Computer</option>
        <option value="Power / UPS">Power / UPS</option>
        <option value="Accessory">Accessory</option>
      </select>
    </div>

    <div class="mb-3">
      <label for="brand" class="form-label">Brand</label>
      <input type="text" class="form-control" id="brand" name="brand" placeholder="Dell">
    </div>

    <div class="mb-3">
      <label for="ipAddress" class="form-label">IP Address</label>
      <input type="text" class="form-control" id="ipAddress" name="ipAddress" placeholder="192.168.1.10">
    </div>

    <div class="mb-3">
      <label for="location" class="form-label">Location</label>
      <input type="text" class="form-control" id="location" name="location" placeholder="Rack shelf 2">
    </div>

    <div class="mb-3">
      <label for="status" class="form-label">Status</label>
      <select class="form-select" id="status" name="status">
        <option value="Online">Online</option>
        <option value="Offline">Offline</option>
        <option value="Maintenance">Maintenance</option>
        <option value="Spare">Spare</option>
      </select>
    </div>

    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Device</button>
    <a href="/devices" class="btn btn-secondary">Cancel</a>
  </form>
</main>

<%- include ../partials/footer.ejs %>